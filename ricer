run_lutgen_apply() {
    local src="$1"
    local dest="$2"
    local theme="$3"
    shift 3
    local -a custom_colors=("$@")

    local -a p_opt=()
    local -a c_args=()
    local -a sorted_palette=($(get_palette_colors_sorted "$theme"))

    if [[ ${#custom_colors[@]} -gt 0 ]]; then
        c_args=(-- "${custom_colors[@]}")
    else
        case "${PALETTE_LIMIT:-All}" in
            2)
                if [[ ${#sorted_palette[@]} -ge 2 ]]; then
                    c_args=(-- "${sorted_palette[0]}" "${sorted_palette[-1]}")
                else
                    p_opt=(-p "${theme,,}")
                fi
                ;;
            4)
                if [[ ${#sorted_palette[@]} -ge 4 ]]; then
                    local n=${#sorted_palette[@]}
                    c_args=(-- "${sorted_palette[0]}" "${sorted_palette[$(( n / 3 ))]}" "${sorted_palette[$(( (2 * n) / 3 ))]}" "${sorted_palette[$(( n - 1 ))]}")
                else
                    c_args=(-- "${sorted_palette[@]}")
                fi
                ;;
            8)
                if [[ ${#sorted_palette[@]} -ge 8 ]]; then
                    local n=${#sorted_palette[@]}
                    local -a subset=()
                    for ((k=0; k<8; k++)); do
                        subset+=("${sorted_palette[$(( (k * (n - 1)) / 7 ))]}")
                    done
                    c_args=(-- "${subset[@]}")
                else
                    c_args=(-- "${sorted_palette[@]}")
                fi
                ;;
            *)
                local candidate="${theme,,}"
                if lutgen palette "$candidate" &>/dev/null; then
                    p_opt=(-p "$candidate")
                elif lutgen palette "${candidate}-dark" &>/dev/null; then
                    p_opt=(-p "${candidate}-dark")
                else
                    if [[ ${#sorted_palette[@]} -gt 0 ]]; then
                        c_args=(-- "${sorted_palette[@]}")
                    else
                        p_opt=(-p "$candidate")
                    fi
                fi
                ;;
        esac
    fi

    lutgen apply "${LUTGEN_ARGS[@]}" "${p_opt[@]}" "$src" -o "$dest" "${c_args[@]}"
}

abs_path() { realpath -m "$1" 2>/dev/null || printf '%s' "$1"; }

compute_settings_stamp() {
    local theme="$1"
    printf '%s' "${theme}#${LUTGEN_ARGS[*]}#${SELECTED_COLORS[*]}#${COLOR_STRENGTH}#${SATURATION}#${CONTRAST}#${BRIGHTNESS}#${PALETTE_LIMIT}#${IM_CMD}" | md5sum | cut -d' ' -f1
}

prune_stamps() {
    local f line dest
    for f in "$STAMPS_DIR"/*; do
        [[ -f "$f" ]] || continue
        line=$(< "$f")
        dest="${line#* }"
        [[ -n "$dest" && ! -f "$dest" ]] && rm -f "$f"
    done
}

process_image() {
    local src="$1" dest="$2" theme="$3"
    local dest_abs key stamp_file stamp
    dest_abs=$(abs_path "$dest")
    key=$(printf '%s' "$dest_abs" | md5sum | cut -d' ' -f1)
    stamp_file="$STAMPS_DIR/$key"
    stamp=$(compute_settings_stamp "$theme")
    mkdir -p "$STAMPS_DIR"

    if [[ -f "$dest" && ! "$src" -nt "$dest" && -f "$stamp_file" && "$(< "$stamp_file")" == "$stamp $dest_abs" ]]; then
        return 1
    fi

    mkdir -p "$(dirname "$dest")"
    cp "$src" "$dest"

    local tmp="${dest}_lutgen_tmp.${dest##*.}"
    local err_file
    err_file=$(mktemp)

    if run_lutgen_apply "$dest" "$tmp" "$theme" "${SELECTED_COLORS[@]}" &>"$err_file"; then
        mv "$tmp" "$dest"
        rm -f "$err_file"
        printf '%s %s' "$stamp" "$dest_abs" > "$stamp_file"

        if (( 10#$COLOR_STRENGTH < 100 )); then
            "$IM_CMD" "$src" "$dest" -define compose:args="$COLOR_STRENGTH" -compose blend -composite "$dest" 2>/dev/null
        fi

        if [[ "$SATURATION" != "100" || "$CONTRAST" != "0" || "$BRIGHTNESS" != "100" ]]; then
            "$IM_CMD" "$dest" -modulate "${BRIGHTNESS},${SATURATION},100" -brightness-contrast "0x${CONTRAST}" "$dest" 2>/dev/null
        fi

        return 0
    else
        rm -f "$tmp" "$dest" "$stamp_file"
        echo -e "${C_RED}[ERROR] lutgen failed for '$src':${C_RESET}" >&2
        sed 's/^/  /' "$err_file" >&2
        rm -f "$err_file"
        return 2
    fi
}

process_batch() {
    local theme="$1" mode="$2" source_dir="$3"
    shift 3
    local -a files=("$@")
    ((${#files[@]} == 0)) && return 0

    local status_dir
    status_dir=$(mktemp -d)
    local i=0 running=0 img dest

    for img in "${files[@]}"; do
        if [[ "$mode" == "folder" ]]; then
            dest="$DEST_FINAL/${img#"$source_dir"/}"
        else
            dest="$DEST_FINAL/$(basename "$img")"
        fi
        (
            process_image "$img" "$dest" "$theme"
            printf '%s' "$?" > "$status_dir/$i"
        ) &
        running=$((running + 1))
        if (( running >= MAX_JOBS )); then
            wait -n
            running=$((running - 1))
        fi
        i=$((i + 1))
    done
    wait

    local s
    for s in "$status_dir"/*; do
        case "$(< "$s")" in
            0) count_ok=$((count_ok + 1));;
            1) count_skip=$((count_skip + 1));;
            *) count_err=$((count_err + 1));;
        esac
    done
    rm -rf "$status_dir"
}

