prompt_setting_value() {
    local label="$1" current="$2" presets="$3" regex="$4"
    local out query selected choice ret

    out=$(printf "%s\n" $presets | fzf --prompt="$label ❯ " \
        --header="Current: $current | Select or type new value, then [ENTER] | [ESC]: Cancel" \
        --print-query)
    ret=$?

    [[ $ret -ne 0 ]] && return 1
    [[ -z "$out" ]] && return 1

    query=$(head -n 1 <<< "$out")
    selected=$(tail -n 1 <<< "$out")

    choice="$selected"
    if [[ -n "$query" && "$query" != "$selected" ]]; then
        choice="$query"
    fi

    [[ -z "$choice" ]] && return 1

    if [[ -n "$regex" && ! "$choice" =~ $regex ]]; then
        echo -e "${C_RED}[!] Invalid value: '$choice'.${C_RESET}"
        sleep 1
        return 1
    fi

    echo "$choice"
}

resolve_theme_variants() {
    local pal="$CURRENT_PALETTE"
    local base="${pal%-dark}"
    base="${base%-light}"

    DEST_BASE="$base"

    if [[ -f "$LUTGEN_DIR/${base}-dark" && -f "$LUTGEN_DIR/${base}-light" ]]; then
        THEME_DARK="${base}-dark"
        THEME_LIGHT="${base}-light"
        return
    fi

    if lutgen palette "${base}-dark" &>/dev/null && lutgen palette "${base}-light" &>/dev/null; then
        THEME_DARK="${base}-dark"
        THEME_LIGHT="${base}-light"
        return
    fi

    if [[ "$pal" == *"-dark" ]]; then
        THEME_DARK="$pal"
        local light_cand="${pal%-dark}-light"
        if [[ -f "$LUTGEN_DIR/$light_cand" ]] || lutgen palette "$light_cand" &>/dev/null; then
            THEME_LIGHT="$light_cand"
        else
            THEME_LIGHT="$pal"
        fi
        return
    fi

    if [[ "$pal" == *"-light" ]]; then
        THEME_LIGHT="$pal"
        local dark_cand="${pal%-light}-dark"
        if [[ -f "$LUTGEN_DIR/$dark_cand" ]] || lutgen palette "$dark_cand" &>/dev/null; then
            THEME_DARK="$dark_cand"
        else
            THEME_DARK="$pal"
        fi
        return
    fi

    THEME_DARK="$pal"
    THEME_LIGHT="$pal"
}

