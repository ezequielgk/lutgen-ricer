                    SAMPLE_WALLPAPER=$(printf "%s\n" "${SELECTED_FILES[@]}" | fzf \
                        --prompt="  Select Sample Image to Preview & Tune ❯ " \
                        --header="[ENTER]: Pick reference image for tuning | [ESC]: Back" \
                        --preview 'chafa -f sixel -s "${FZF_PREVIEW_COLUMNS}x${FZF_PREVIEW_LINES}" {} 2>/dev/null || chafa {}' \
                        --preview-window=right:55%:border-left)
                    [[ -z "$SAMPLE_WALLPAPER" ]] && { STATE="SOURCE"; continue; }
                else
                    SAMPLE_WALLPAPER="${SELECTED_FILES[0]}"
                fi
            fi
            STATE="TUNE_SETTINGS"
            ;;

        "TUNE_SETTINGS")
            context_name="Folder: $SOURCE_DIR"
            [[ "$SOURCE_MODE" == "Individual" ]] && context_name=$(basename "$SAMPLE_WALLPAPER")

            if interactive_tune_settings "$SAMPLE_WALLPAPER" "$context_name"; then
                resolve_theme_variants
                STATE="VARIANT"
            else
                STATE="SOURCE"
            fi
            ;;

        "VARIANT")
            VAR_CHOICE=$(printf "Dark\nLight\nBoth" | fzf --prompt="  Variant to generate ❯ " --header="[ESC]: Back to tuning")
            [[ -z "$VAR_CHOICE" ]] && { STATE="TUNE_SETTINGS"; continue; }

            case "$VAR_CHOICE" in
                Dark) VARIANT_LIST=("dark") ;;
                Light) VARIANT_LIST=("light") ;;
                Both) VARIANT_LIST=("dark" "light") ;;
            esac
            STATE="PROCESS"
            ;;

        "PROCESS")
            count_ok=0; count_skip=0; count_err=0

            build_lutgen_args

            echo -e "${C_CYAN}    Parallel jobs: $MAX_JOBS (override with MAX_JOBS=N)${C_RESET}"

            for var in "${VARIANT_LIST[@]}"; do
                current_theme=$([[ "$var" == "dark" ]] && echo "$THEME_DARK" || echo "$THEME_LIGHT")

                if [[ "$SOURCE_MODE" == "Individual" ]]; then
                    DEST_FINAL="$DEST_BASE/$var"
                else
                    DEST_FINAL="$DEST_BASE/$SOURCE_DIR/$var"
                fi

                mkdir -p "$DEST_FINAL"
                echo -e "\n${C_BLUE}[*] Generating variant '$var' in '$DEST_FINAL'...${C_RESET}"

                if [[ "$SOURCE_MODE" == "Full folder" ]]; then
                    mapfile -t batch_files < <(find "$SOURCE_DIR" -type f \( "${IMG_PATTERN[@]}" \))
                    process_batch "$current_theme" "folder" "$SOURCE_DIR" "${batch_files[@]}"
                else
                    process_batch "$current_theme" "individual" "" "${SELECTED_FILES[@]}"
                fi
            done

            echo -e "\n${C_GREEN}[OK] Process completed successfully.${C_RESET}"
            echo -e "${C_CYAN}    Generated: $count_ok  |  Skipped (Cache): $count_skip  |  Errors: $count_err${C_RESET}\n"

            exit 0
            ;;
    esac
done

fi
